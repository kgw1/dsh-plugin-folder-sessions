{
  "name": "dsh-plugin-folder-sessions",
  "version": "0.1.0",
  "description": "DSH plugin: the New Session button creates a fresh session workspace folder under a configurable root, and renaming an auto-created workspace renames its folder too.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "cordis.patch.yml",
    "assets",
    "docs/evidence",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/build-client.mjs && node --check client.js && node --check index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "pack:local": "npm pack --pack-destination dist",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "icon": "./assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "workspace",
    "folder"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
